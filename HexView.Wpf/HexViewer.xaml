<UserControl x:Class="Juknum.HexView.Wpf.HexViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Juknum.HexView.Wpf"
             xmlns:converters="clr-namespace:Juknum.HexView.Wpf.Converters"
             xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             x:Name="root"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             FontFamily="Consolas"
             FontSize="13">
    
    <UserControl.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:MultiEqualityConverter x:Key="MultiEqualityConverter"/>
    </UserControl.Resources>

    <Grid FocusManager.FocusedElement="{Binding ElementName=root}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Canvas x:Name="PART_Canvas"
                Background="{Binding ElementName=root, Path=Background}"
                Tag="{Binding ElementName=root}"
                ClipToBounds="True"
                Margin="5">
            <Canvas.ContextMenu>
                <ContextMenu FontFamily="Segoe UI" FontSize="12"
                             DataContext="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="No Data" Command="{Binding SetNoDataCommand}">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <Binding Path="ShowData" Converter="{StaticResource EqualityConverter}">
                                        <Binding.ConverterParameter>
                                            <system:Boolean>false</system:Boolean>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="1-Byte Integer" Command="{Binding SetIntegerFormatCommand}" CommandParameter="1">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>Integer</local:DataType>
                                                <system:Int32>1</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="2-Byte Integer" Command="{Binding SetIntegerFormatCommand}" CommandParameter="2">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>Integer</local:DataType>
                                                <system:Int32>2</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="4-Byte Integer" Command="{Binding SetIntegerFormatCommand}" CommandParameter="4">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>Integer</local:DataType>
                                                <system:Int32>4</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="8-Byte Integer" Command="{Binding SetIntegerFormatCommand}" CommandParameter="8">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>Integer</local:DataType>
                                                <system:Int32>8</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="32-bit Floating Point" Command="{Binding SetFloatingPointFormatCommand}" CommandParameter="4">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>FloatingPoint</local:DataType>
                                                <system:Int32>4</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="64-bit Floating Point" Command="{Binding SetFloatingPointFormatCommand}" CommandParameter="8">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                        <MultiBinding.ConverterParameter>
                                            <collections:ArrayList>
                                                <system:Boolean>true</system:Boolean>
                                                <local:DataType>FloatingPoint</local:DataType>
                                                <system:Int32>8</system:Int32>
                                            </collections:ArrayList>
                                        </MultiBinding.ConverterParameter>
                                        <Binding Path="ShowData"/>
                                        <Binding Path="DataType"/>
                                        <Binding Path="DataWidth"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="Hexadecimal" Command="{Binding SetDataFormatCommand}" CommandParameter="{x:Static local:DataFormat.Hexadecimal}">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <Binding Path="DataFormat" Converter="{StaticResource EqualityConverter}">
                                        <Binding.ConverterParameter>
                                            <local:DataFormat>Hexadecimal</local:DataFormat>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                        <MenuItem.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                <MultiBinding.ConverterParameter>
                                    <collections:ArrayList>
                                        <system:Boolean>true</system:Boolean>
                                        <local:DataType>Integer</local:DataType>
                                    </collections:ArrayList>
                                </MultiBinding.ConverterParameter>
                                <Binding Path="ShowData"/>
                                <Binding Path="DataType"/>
                            </MultiBinding>
                        </MenuItem.IsEnabled>
                    </MenuItem>

                    <MenuItem Header="Decimal" Command="{Binding SetDataFormatCommand}" CommandParameter="{x:Static local:DataFormat.Decimal}">
                        <MenuItem.Icon>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Visibility>
                                    <Binding Path="DataFormat" Converter="{StaticResource EqualityConverter}">
                                        <Binding.ConverterParameter>
                                            <local:DataFormat>Decimal</local:DataFormat>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </MenuItem.Icon>
                        <MenuItem.IsEnabled>
                            <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                <MultiBinding.ConverterParameter>
                                    <collections:ArrayList>
                                        <system:Boolean>true</system:Boolean>
                                        <local:DataType>Integer</local:DataType>
                                    </collections:ArrayList>
                                </MultiBinding.ConverterParameter>
                                <Binding Path="ShowData"/>
                                <Binding Path="DataType"/>
                            </MultiBinding>
                        </MenuItem.IsEnabled>
                    </MenuItem>

                    <Separator/>

                    <MenuItem Header="{Binding ToggleSignednessHeader}" Command="{Binding ToggleSignednessCommand}"/>

                    <MenuItem Header="{Binding ToggleEndiannessHeader}" Command="{Binding ToggleEndiannessCommand}"/>

                    <Separator/>

                    <MenuItem Header="{Binding ToggleTextHeader}" Command="{Binding ToggleTextCommand}"/>

                    <Separator/>

                    <MenuItem Header="Copy"
                              Command="{x:Static ApplicationCommands.Copy}"
                              CommandTarget="{Binding Path=PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              InputGestureText="Ctrl+C"/>
                </ContextMenu>
            </Canvas.ContextMenu>
        </Canvas>

        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"/>
    </Grid>
</UserControl>
