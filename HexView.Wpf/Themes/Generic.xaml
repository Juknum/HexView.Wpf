<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Juknum.HexView"
                    xmlns:enums="clr-namespace:Juknum.HexView.Enums"
                    xmlns:converters="clr-namespace:Juknum.HexView.Common.Converters"
                    xmlns:collections="clr-namespace:System.Collections;assembly=mscorlib"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <converters:EqualityConverter x:Key="EqualityConverter"/>
    <converters:MultiEqualityConverter x:Key="MultiEqualityConverter"/>

    <Style TargetType="{x:Type local:HexViewer}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HexViewer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <local:HexRenderSurface x:Name="PART_Canvas"
                                                    ClipToBounds="True"
                                                    Margin="5">
                                <local:HexRenderSurface.ContextMenu>
                                    <ContextMenu FontFamily="Segoe UI" FontSize="12"
                                                 DataContext="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="No Data"
                                                  Command="{x:Static local:HexViewer.SetNoDataCommand}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <Binding Path="ShowData" Converter="{StaticResource EqualityConverter}">
                                                            <Binding.ConverterParameter>
                                                                <system:Boolean>false</system:Boolean>
                                                            </Binding.ConverterParameter>
                                                        </Binding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="1-Byte Integer"
                                                  Command="{x:Static local:HexViewer.SetIntegerFormatCommand}"
                                                  CommandParameter="1"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>Integer</enums:DataType>
                                                                    <system:Int32>1</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="2-Byte Integer"
                                                  Command="{x:Static local:HexViewer.SetIntegerFormatCommand}"
                                                  CommandParameter="2"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>Integer</enums:DataType>
                                                                    <system:Int32>2</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="4-Byte Integer"
                                                  Command="{x:Static local:HexViewer.SetIntegerFormatCommand}"
                                                  CommandParameter="4"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>Integer</enums:DataType>
                                                                    <system:Int32>4</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="8-Byte Integer"
                                                  Command="{x:Static local:HexViewer.SetIntegerFormatCommand}"
                                                  CommandParameter="8"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>Integer</enums:DataType>
                                                                    <system:Int32>8</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator/>

                                        <MenuItem Header="32-bit Floating Point"
                                                  Command="{x:Static local:HexViewer.SetFloatingPointFormatCommand}"
                                                  CommandParameter="4"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>FloatingPoint</enums:DataType>
                                                                    <system:Int32>4</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="64-bit Floating Point"
                                                  Command="{x:Static local:HexViewer.SetFloatingPointFormatCommand}"
                                                  CommandParameter="8"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                            <MultiBinding.ConverterParameter>
                                                                <collections:ArrayList>
                                                                    <system:Boolean>true</system:Boolean>
                                                                    <enums:DataType>FloatingPoint</enums:DataType>
                                                                    <system:Int32>8</system:Int32>
                                                                </collections:ArrayList>
                                                            </MultiBinding.ConverterParameter>
                                                            <Binding Path="ShowData"/>
                                                            <Binding Path="DataType"/>
                                                            <Binding Path="DataWidth"/>
                                                        </MultiBinding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <Separator/>

                                        <MenuItem Header="Hexadecimal"
                                                  Command="{x:Static local:HexViewer.SetDataFormatCommand}"
                                                  CommandParameter="{x:Static enums:DataFormat.Hexadecimal}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <Binding Path="DataFormat" Converter="{StaticResource EqualityConverter}">
                                                            <Binding.ConverterParameter>
                                                                <enums:DataFormat>Hexadecimal</enums:DataFormat>
                                                            </Binding.ConverterParameter>
                                                        </Binding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                            <MenuItem.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                    <MultiBinding.ConverterParameter>
                                                        <collections:ArrayList>
                                                            <system:Boolean>true</system:Boolean>
                                                            <enums:DataType>Integer</enums:DataType>
                                                        </collections:ArrayList>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding Path="ShowData"/>
                                                    <Binding Path="DataType"/>
                                                </MultiBinding>
                                            </MenuItem.IsEnabled>
                                        </MenuItem>

                                        <MenuItem Header="Decimal"
                                                  Command="{x:Static local:HexViewer.SetDataFormatCommand}"
                                                  CommandParameter="{x:Static enums:DataFormat.Decimal}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Icon>
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RelativeSource={RelativeSource AncestorType=MenuItem}, Path=Foreground}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Visibility>
                                                        <Binding Path="DataFormat" Converter="{StaticResource EqualityConverter}">
                                                            <Binding.ConverterParameter>
                                                                <enums:DataFormat>Decimal</enums:DataFormat>
                                                            </Binding.ConverterParameter>
                                                        </Binding>
                                                    </Ellipse.Visibility>
                                                </Ellipse>
                                            </MenuItem.Icon>
                                            <MenuItem.IsEnabled>
                                                <MultiBinding Converter="{StaticResource MultiEqualityConverter}">
                                                    <MultiBinding.ConverterParameter>
                                                        <collections:ArrayList>
                                                            <system:Boolean>true</system:Boolean>
                                                            <enums:DataType>Integer</enums:DataType>
                                                        </collections:ArrayList>
                                                    </MultiBinding.ConverterParameter>
                                                    <Binding Path="ShowData"/>
                                                    <Binding Path="DataType"/>
                                                </MultiBinding>
                                            </MenuItem.IsEnabled>
                                        </MenuItem>

                                        <Separator/>

                                        <MenuItem Header="{Binding ToggleSignednessHeader}"
                                                  Command="{x:Static local:HexViewer.ToggleSignednessCommand}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                        <MenuItem Header="{Binding ToggleEndiannessHeader}"
                                                  Command="{x:Static local:HexViewer.ToggleEndiannessCommand}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                        <Separator/>

                                        <MenuItem Header="{Binding ToggleTextHeader}"
                                                  Command="{x:Static local:HexViewer.ToggleTextCommand}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                        <Separator/>

                                        <MenuItem Header="Copy"
                                                  Command="{x:Static ApplicationCommands.Copy}"
                                                  CommandTarget="{Binding Path=PlacementTarget.TemplatedParent, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  InputGestureText="Ctrl+C"/>
                                    </ContextMenu>
                                </local:HexRenderSurface.ContextMenu>
                            </local:HexRenderSurface>

                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
